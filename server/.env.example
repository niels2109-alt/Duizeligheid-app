DATABASE_URL="file:./dev.db"

# 32 bytes (64 hex-tekens) — sleutel voor AES-256-GCM, zie src/crypto.ts (§5.3).
# Genereer je eigen sleutel met: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="vervang-dit-met-64-hex-tekens"

# Voor het ondertekenen van sessie-JWT's (§5.2).
# Genereer je eigen secret met: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="vervang-dit-met-een-lange-willekeurige-string"
