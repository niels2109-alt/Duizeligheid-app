// Datamodel voor het Duizeligheid-platform — stap 1 + 4 (Bouwvolgorde §6.2)
//
// Vertaling van Duizeligheid-Technische-Requirements-MVP.md §1 naar Prisma/SQLite.
// KnowledgeObject, Relatie, PatiëntEducatieObject: §1.1, 1.2, 1.3, 1.4 (stap 1).
// Sessie, StapLog: §1.5 (stap 4). Therapeut is geen entiteit uit het
// requirements-document zelf — nodig als minimale infrastructuur voor de
// "individueel account per therapeut"-eis (§5.2), die het document wel
// vaststelt maar geen datamodel voor geeft.
//
// Encryptie (§5.3, "encryptie bij opslag"): StapLog.bevinding en
// Sessie.samenvatting bevatten de klinische (bijzondere-persoonsgegevens-)
// inhoud van een sessie (§23) en worden versleuteld opgeslagen (AES-256-GCM,
// zie src/crypto.ts) — vandaar de "Enc"-suffix op die velden. Overige
// velden (object-id's, timestamps, stap-type) zijn geen patiëntgegevens en
// blijven leesbaar voor filtering/sortering.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Gesloten lijst van objecttypes — requirements §1.2.
/// "FACTOR-xxx"-objecten zijn geen apart hoofdtype, maar
/// type_object = prognostische_factor (zie referentiedocument §1, §16).
enum TypeObject {
  aandoening
  symptoom
  onderzoekstest
  interventie
  red_flag
  patienteducatie_item
  clinical_pearl
  prognostische_factor
  contra_indicatie
  anamnese_item
}

enum Behandelverantwoordelijkheid {
  zelfstandig_fysio
  gedeeld_multidisciplinair
  niet_fysio_verwijzen
}

enum Behandeldiepte {
  volledig
  beperkt
  geen
}

/// Stuurt reasoning-flow-gedrag (referentiedocument §19) — nog niet relevant
/// voor de database zelf in stap 1, maar wel al correct vastgelegd per object.
enum Uitkomsttype {
  enkelvoudig
  samengesteld
}

enum EvidenceNiveau {
  richtlijn
  systematic_review
  rct
  observationeel
  consensus
  expert_opinion
  eigen_klinische_expertise
}

enum ObjectStatus {
  concept
  in_review
  gepubliceerd
  verouderd
}

/// Vier vastgestelde relatietypes (referentiedocument §17) + differentiaal.
/// bevinding_interpretatie wordt in dit schema ook hergebruikt voor
/// verband-typen die het referentiedocument niet als apart relatietype heeft
/// benoemd (interventie-indicatie, contra-indicatie-koppeling, clinical-pearl-
/// koppeling) — zie server/prisma/seed.ts bovenaan voor de onderbouwing en
/// het antwoord van de opdrachtgever hierover.
enum RelatieType {
  bevinding_interpretatie
  voorwaarde
  aggregatie
  signalering_opvolging
  differentiaal
}

enum DiagnostischeWaarde {
  hoog
  matig
  laag
}

enum RelatietypeDifferentiaal {
  uitsluitend
  comorbide
}

enum BijdrageGewicht {
  hoog
  matig_hoog
  matig
}

enum PatroonType {
  verwachte_fluctuatie
  afwijkend_beloop
}

enum ActieType {
  acuut_verwijzen
  hypothese_heroverwegen
  samenwerking_adviseren
}

/// StapLog.stap_type — requirements §1.5.
enum StapType {
  triage
  anamnese
  test
  interpretatie
  strategie
  educatie
  followup
}

// ---------------------------------------------------------------------------
// Entiteiten
// ---------------------------------------------------------------------------

/// KnowledgeObject — requirements §1.1.
model KnowledgeObject {
  id String @id

  naam       String
  typeObject TypeObject @map("type_object")

  // Verplicht bij type_object = aandoening (§1.1); voor overige types null.
  behandelverantwoordelijkheid Behandelverantwoordelijkheid?
  behandeldiepte               Behandeldiepte?
  /// Afgeleid uit behandelverantwoordelijkheid + behandeldiepte, niet los
  /// invoerbaar (§1.1). Het brondocument specificeert geen formule voor deze
  /// afleiding — hier vooralsnog als los veld opgeslagen op basis van de
  /// letterlijk in het referentiedocument genoemde tier per item/stub.
  tier         Int?
  uitkomsttype Uitkomsttype?

  kernbeschrijving    String
  klinischeKenmerken  String? @map("klinische_kenmerken")

  evidenceNiveau EvidenceNiveau @map("evidence_niveau")
  /// Array van {auteur, jaar, type, link} — als JSON-tekst opgeslagen (SQLite
  /// kent geen los array-kolomtype). Optioneel; in stap 1 voor alle objecten
  /// leeg gelaten omdat het brondocument geen gestructureerde bronnenlijst
  /// per object geeft, alleen evidence-niveau-labels.
  bronnen String?

  status                ObjectStatus
  laatstGecontroleerdOp DateTime     @map("laatst_gecontroleerd_op")

  zichtbaarTherapeut Boolean @default(true) @map("zichtbaar_therapeut")
  zichtbaarPatient   Boolean @map("zichtbaar_patient")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  relatiesVanuit  Relatie[] @relation("VanObject")
  relatiesNaartoe Relatie[] @relation("NaarObject")

  patientEducatieObject PatientEducatieObject?

  sessies          Sessie[]
  behandelepisodes Behandelepisode[]

  @@map("knowledge_objects")
}

/// Relatie — requirements §1.3.
model Relatie {
  id String @id

  vanObjectId String          @map("van_object_id")
  vanObject   KnowledgeObject @relation("VanObject", fields: [vanObjectId], references: [id])

  naarObjectId String          @map("naar_object_id")
  naarObject   KnowledgeObject @relation("NaarObject", fields: [naarObjectId], references: [id])

  relatieType RelatieType @map("relatie_type")

  /// Vrij uitbreidbare key-value set (bijv. subtype=posterior, variant=canalolithiasis),
  /// als JSON-tekst opgeslagen.
  kwalificatie String?

  bevinding     String?
  interpretatie String?

  diagnostischeWaarde DiagnostischeWaarde? @map("diagnostische_waarde")
  /// Voor het conditionele geval (referentiedocument §19, PPPD-voorbeeld):
  /// verwijzing naar de Relatie (voorwaarde-relatie) waarvan deze
  /// diagnostische waarde afhankelijk is, i.p.v. een vaste waarde.
  /// Bewust geen FK-constraint (zelfreferentie op dit niveau is voor BPPV
  /// niet nodig, zie requirements §1.3 toelichting).
  diagnostischeWaardeVoorwaardeRelatieId String? @map("diagnostische_waarde_voorwaarde_relatie_id")

  relatietypeDifferentiaal RelatietypeDifferentiaal? @map("relatietype_differentiaal")
  bijdrageGewicht          BijdrageGewicht?           @map("bijdrage_gewicht")
  patroonType              PatroonType?               @map("patroon_type")
  actietype                ActieType?

  evidenceNiveau EvidenceNiveau? @map("evidence_niveau")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("relaties")
}

/// PatiëntEducatieObject — requirements §1.4 (specialisatie van KnowledgeObject,
/// type_object = patienteducatie_item).
model PatientEducatieObject {
  id String @id

  knowledgeObjectId String          @unique @map("knowledge_object_id")
  knowledgeObject   KnowledgeObject @relation(fields: [knowledgeObjectId], references: [id])

  /// Verplicht veld, nadruk mag licht zijn (§1.4, referentiedocument §18).
  verwachtingsmanagement String

  rationaleUitlegCounterintuitief String? @map("rationale_uitleg_counterintuitief")

  samengesteld Boolean @default(false)

  /// Array van FK's naar KnowledgeObject — als JSON-tekst opgeslagen.
  bronObjectIds String @map("bron_object_ids")
  /// Array van FK's naar red-flag-objecten — als JSON-tekst opgeslagen.
  signaleringObjectIds String @map("signalering_object_ids")

  // leesniveau: bewust niet geïmplementeerd in MVP (open modelveld, zie
  // referentiedocument §1 / §21 en requirements §1.4).

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("patient_educatie_objecten")
}

/// Therapeut — individueel account, requirements §5.2. Geen entiteit uit
/// §1; minimale infrastructuur voor "individueel account per therapeut
/// (e-mail + wachtwoord of magic link), geen gedeeld/generiek account".
/// Hier gekozen voor e-mail + wachtwoord (bcrypt-hash) — zelfstandig te
/// testen zonder een externe e-mailprovider, wat voor magic link wel nodig
/// zou zijn. Geen 2FA/SSO, conform §5.2.
model Therapeut {
  id String @id @default(cuid())

  email          String @unique
  wachtwoordHash String @map("wachtwoord_hash")

  aangemaaktOp DateTime @default(now()) @map("aangemaakt_op")

  sessies          Sessie[]
  behandelepisodes Behandelepisode[]

  @@map("therapeuten")
}

/// Sessie — requirements §1.5. Bevat bewust geen patiëntnaam of ander
/// direct identificerend gegeven (expliciete eis, §1.5) — identificatie
/// (welke patiënt) blijft de verantwoordelijkheid van het bestaande EPD van
/// de therapeut.
model Sessie {
  id String @id @default(cuid())

  therapeutId String    @map("therapeut_id")
  therapeut   Therapeut @relation(fields: [therapeutId], references: [id])

  gestartOp DateTime @default(now()) @map("gestart_op")

  /// Pas gezet zodra de flow convergeert op een hoofdhypothese (§1.5).
  aandoeningId String?          @map("aandoening_id")
  aandoening   KnowledgeObject? @relation(fields: [aandoeningId], references: [id])

  /// Requirements §8.4: koppelt opeenvolgende sessies van hetzelfde
  /// behandeltraject aan elkaar voor trendweergave (PPPD). Nullable — bij
  /// BPPV/vestibulaire hypofunctie niet verplicht/functioneel niet nodig.
  episodeId String?          @map("episode_id")
  episode   Behandelepisode? @relation(fields: [episodeId], references: [id])

  stappen StapLog[]

  /// Versleutelde samenvattingstekst — pas gevuld bij export (§2.3), zodat
  /// de geëxporteerde tekst een vaste momentopname is. Vóór export wordt de
  /// samenvatting on-the-fly uit `stappen` opgebouwd (GET /api/sessies/:id).
  samenvattingEnc String? @map("samenvatting_enc")

  geëxporteerdOp DateTime? @map("geexporteerd_op")

  /// Verplicht, geen default (§1.5/§5.1, expliciete open beslissing uit het
  /// requirements-document, hier vastgesteld op gestartOp + 90 dagen, of
  /// "nu" zodra geëxporteerd — zie src/sessies.ts).
  vervaltOp DateTime @map("vervalt_op")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sessies")
}

enum EpisodeStatus {
  actief
  afgesloten
}

/// Behandelepisode — requirements §8.4 (PPPD-aanvulling). Groepeert
/// opeenvolgende Sessies van hetzelfde behandeltraject, chronologisch via
/// Sessie.gestartOp — nodig voor trendweergave (bijv. NPQ-score over
/// meerdere sessies, mogelijk maanden). Niet eerder nodig: bij BPPV en
/// vestibulaire hypofunctie was follow-up steeds een vergelijking met de
/// vorige sessie, geen sessie-overstijgende trend.
///
/// `sessie_ids` uit de requirements-tabel is hier de reverse relation
/// (Sessie.episodeId) i.p.v. een los opgeslagen array — normaliseert de
/// koppeling (één bron van waarheid) en levert de chronologische volgorde
/// al via Sessie.gestartOp, zonder een JSON-array te hoeven synchroniseren.
///
/// Blijft, net als Sessie zelf, een tijdelijke groepering van vervallende
/// sessies (§13: geen volledige dossiervoering) — geen permanent
/// patiëntdossier. `vervaltOp` verlengt mee met elke nieuw gekoppelde
/// Sessie (nooit verkort door een individuele export), zodat de episode
/// nooit langer bestaat dan haar laatst vervallende sessie.
model Behandelepisode {
  id String @id @default(cuid())

  aandoeningId String          @map("aandoening_id")
  aandoening   KnowledgeObject @relation(fields: [aandoeningId], references: [id])

  therapeutId String    @map("therapeut_id")
  therapeut   Therapeut @relation(fields: [therapeutId], references: [id])

  gestartOp DateTime      @default(now()) @map("gestart_op")
  status    EpisodeStatus @default(actief)

  vervaltOp DateTime @map("vervalt_op")

  sessies Sessie[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("behandelepisodes")
}

/// StapLog — sub-object van Sessie, requirements §1.5.
model StapLog {
  id String @id @default(cuid())

  sessieId String @map("sessie_id")
  sessie   Sessie @relation(fields: [sessieId], references: [id], onDelete: Cascade)

  stapType StapType @map("stap_type")

  /// Array van gebruikte object-id's — als JSON-tekst opgeslagen. Geen
  /// patiëntgegeven (verwijst alleen naar kennisbank-objecten), dus
  /// onversleuteld.
  objectIdsGebruikt String @map("object_ids_gebruikt")

  /// Versleuteld (§5.3) — dit is de klinische inhoud van de stap.
  bevindingEnc String? @map("bevinding_enc")

  timestamp DateTime @default(now())

  @@map("staplog")
}
