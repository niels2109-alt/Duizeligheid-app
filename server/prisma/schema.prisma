// Datamodel voor het Duizeligheid-platform — stap 1 (Bouwvolgorde §6.2)
//
// Vertaling van Duizeligheid-Technische-Requirements-MVP.md §1 naar Prisma/SQLite.
// Scope van dit schema: KnowledgeObject, Relatie, PatiëntEducatieObject (§1.1, 1.2, 1.3, 1.4).
// De Sessie- en StapLog-entiteiten (§1.5) horen bij bouwstap 4 (§6.2) en zijn hier
// bewust nog niet opgenomen.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Gesloten lijst van objecttypes — requirements §1.2.
/// "FACTOR-xxx"-objecten zijn geen apart hoofdtype, maar
/// type_object = prognostische_factor (zie referentiedocument §1, §16).
enum TypeObject {
  aandoening
  symptoom
  onderzoekstest
  interventie
  red_flag
  patienteducatie_item
  clinical_pearl
  prognostische_factor
  contra_indicatie
  anamnese_item
}

enum Behandelverantwoordelijkheid {
  zelfstandig_fysio
  gedeeld_multidisciplinair
  niet_fysio_verwijzen
}

enum Behandeldiepte {
  volledig
  beperkt
  geen
}

/// Stuurt reasoning-flow-gedrag (referentiedocument §19) — nog niet relevant
/// voor de database zelf in stap 1, maar wel al correct vastgelegd per object.
enum Uitkomsttype {
  enkelvoudig
  samengesteld
}

enum EvidenceNiveau {
  richtlijn
  systematic_review
  rct
  observationeel
  consensus
  expert_opinion
  eigen_klinische_expertise
}

enum ObjectStatus {
  concept
  in_review
  gepubliceerd
  verouderd
}

/// Vier vastgestelde relatietypes (referentiedocument §17) + differentiaal.
/// bevinding_interpretatie wordt in dit schema ook hergebruikt voor
/// verband-typen die het referentiedocument niet als apart relatietype heeft
/// benoemd (interventie-indicatie, contra-indicatie-koppeling, clinical-pearl-
/// koppeling) — zie server/prisma/seed.ts bovenaan voor de onderbouwing en
/// het antwoord van de opdrachtgever hierover.
enum RelatieType {
  bevinding_interpretatie
  voorwaarde
  aggregatie
  signalering_opvolging
  differentiaal
}

enum DiagnostischeWaarde {
  hoog
  matig
  laag
}

enum RelatietypeDifferentiaal {
  uitsluitend
  comorbide
}

enum BijdrageGewicht {
  hoog
  matig_hoog
  matig
}

enum PatroonType {
  verwachte_fluctuatie
  afwijkend_beloop
}

enum ActieType {
  acuut_verwijzen
  hypothese_heroverwegen
  samenwerking_adviseren
}

// ---------------------------------------------------------------------------
// Entiteiten
// ---------------------------------------------------------------------------

/// KnowledgeObject — requirements §1.1.
model KnowledgeObject {
  id String @id

  naam       String
  typeObject TypeObject @map("type_object")

  // Verplicht bij type_object = aandoening (§1.1); voor overige types null.
  behandelverantwoordelijkheid Behandelverantwoordelijkheid?
  behandeldiepte               Behandeldiepte?
  /// Afgeleid uit behandelverantwoordelijkheid + behandeldiepte, niet los
  /// invoerbaar (§1.1). Het brondocument specificeert geen formule voor deze
  /// afleiding — hier vooralsnog als los veld opgeslagen op basis van de
  /// letterlijk in het referentiedocument genoemde tier per item/stub.
  tier         Int?
  uitkomsttype Uitkomsttype?

  kernbeschrijving    String
  klinischeKenmerken  String? @map("klinische_kenmerken")

  evidenceNiveau EvidenceNiveau @map("evidence_niveau")
  /// Array van {auteur, jaar, type, link} — als JSON-tekst opgeslagen (SQLite
  /// kent geen los array-kolomtype). Optioneel; in stap 1 voor alle objecten
  /// leeg gelaten omdat het brondocument geen gestructureerde bronnenlijst
  /// per object geeft, alleen evidence-niveau-labels.
  bronnen String?

  status                ObjectStatus
  laatstGecontroleerdOp DateTime     @map("laatst_gecontroleerd_op")

  zichtbaarTherapeut Boolean @default(true) @map("zichtbaar_therapeut")
  zichtbaarPatient   Boolean @map("zichtbaar_patient")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  relatiesVanuit  Relatie[] @relation("VanObject")
  relatiesNaartoe Relatie[] @relation("NaarObject")

  patientEducatieObject PatientEducatieObject?

  @@map("knowledge_objects")
}

/// Relatie — requirements §1.3.
model Relatie {
  id String @id

  vanObjectId String          @map("van_object_id")
  vanObject   KnowledgeObject @relation("VanObject", fields: [vanObjectId], references: [id])

  naarObjectId String          @map("naar_object_id")
  naarObject   KnowledgeObject @relation("NaarObject", fields: [naarObjectId], references: [id])

  relatieType RelatieType @map("relatie_type")

  /// Vrij uitbreidbare key-value set (bijv. subtype=posterior, variant=canalolithiasis),
  /// als JSON-tekst opgeslagen.
  kwalificatie String?

  bevinding     String?
  interpretatie String?

  diagnostischeWaarde DiagnostischeWaarde? @map("diagnostische_waarde")
  /// Voor het conditionele geval (referentiedocument §19, PPPD-voorbeeld):
  /// verwijzing naar de Relatie (voorwaarde-relatie) waarvan deze
  /// diagnostische waarde afhankelijk is, i.p.v. een vaste waarde.
  /// Bewust geen FK-constraint (zelfreferentie op dit niveau is voor BPPV
  /// niet nodig, zie requirements §1.3 toelichting).
  diagnostischeWaardeVoorwaardeRelatieId String? @map("diagnostische_waarde_voorwaarde_relatie_id")

  relatietypeDifferentiaal RelatietypeDifferentiaal? @map("relatietype_differentiaal")
  bijdrageGewicht          BijdrageGewicht?           @map("bijdrage_gewicht")
  patroonType              PatroonType?               @map("patroon_type")
  actietype                ActieType?

  evidenceNiveau EvidenceNiveau? @map("evidence_niveau")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("relaties")
}

/// PatiëntEducatieObject — requirements §1.4 (specialisatie van KnowledgeObject,
/// type_object = patienteducatie_item).
model PatientEducatieObject {
  id String @id

  knowledgeObjectId String          @unique @map("knowledge_object_id")
  knowledgeObject   KnowledgeObject @relation(fields: [knowledgeObjectId], references: [id])

  /// Verplicht veld, nadruk mag licht zijn (§1.4, referentiedocument §18).
  verwachtingsmanagement String

  rationaleUitlegCounterintuitief String? @map("rationale_uitleg_counterintuitief")

  samengesteld Boolean @default(false)

  /// Array van FK's naar KnowledgeObject — als JSON-tekst opgeslagen.
  bronObjectIds String @map("bron_object_ids")
  /// Array van FK's naar red-flag-objecten — als JSON-tekst opgeslagen.
  signaleringObjectIds String @map("signalering_object_ids")

  // leesniveau: bewust niet geïmplementeerd in MVP (open modelveld, zie
  // referentiedocument §1 / §21 en requirements §1.4).

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("patient_educatie_objecten")
}
